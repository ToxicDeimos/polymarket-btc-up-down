# Secretos
# Ojo: ".env" a secas NO cubre .env.bak ni .env.local. Una copia de seguridad del .env dentro del
# repo se subiria con las credenciales dentro.
.env
.env.*
!.env.example
*.bak

# Python
__pycache__/
*.pyc
*.log
venv/
.venv/

# Datos de research: NUNCA al repo. Son grandes, crecen solos y se respaldan aparte
# (respaldo_pi.sh). El 3-oct un `git add -A research/` colo 145.000 lineas y un pickle de
# 3,8 MB; el historial ya no se puede limpiar sin reescribirlo, asi que mejor que no entren.
research/*.csv
research/rescate/
research/lab/
research/*.out
research/*.err
research/*.log

# Datos generados en runtime (no son código fuente)
results.csv
results_*.csv          # archivos históricos (pre_fade, pre_volfix, ...) — viven en la Pi
prices.csv
brain_stats.json
status.json

# Tooling local
.claude/

# Datos de investigacion (no codigo, se regeneran)
research/*.csv
research/lab/
maker2_paper_log.csv
maker3_paper_log.csv
favorite_paper_log.csv

# caché de sizing (generada por favorite_sizing.py en la Pi)
research/favorite_sizing_*.json
favorite_paper_*_log.csv
ema_favorite_log.csv

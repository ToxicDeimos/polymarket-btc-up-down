# Copiar a .env y rellenar. El .env NO debe subirse a git (está en .gitignore).
# stalebot lee estas variables del ENTORNO: nunca van en el código y nunca se imprimen.

# Clave privada de la wallet que firma. Solo eso: la clave no sale de tu máquina.
POLY_PK=

# Solo si operas a través de una proxy wallet de Polymarket (lo normal si entraste
# por la web con email o con navegador). Si usas una wallet propia (EOA), déjalos vacíos.
#   0 = EOA · 1 = proxy de email/Magic · 2 = proxy de navegador · 3 = 1271
POLY_SIGNATURE_TYPE=
# Dirección que TIENE los fondos en Polymarket, si es distinta de la que firma.
POLY_FUNDER=

# Segundo cerrojo. Sin esto puesto a "yes", stalebot NO manda ninguna orden
# aunque le pases --live.
STALEBOT_LIVE=

# Copiar a .env y rellenar. El .env NO se sube a git (ya está en .gitignore).
# stalebot lee estas variables del ENTORNO: nunca van en el código y nunca se imprimen.
#
# ⚠ El bot NO carga ningún fichero solo. Hay que cargarlo a mano, y tiene que ser ESTE,
#   el de research/, no el de la raíz del proyecto:
#     cd research && set -a && . ./.env && set +a
#
#   El de la raíz es de otra época del proyecto y le faltan POLY_SIGNATURE_TYPE y
#   POLY_FUNDER. Sin ellas el CLOB V2 rechaza las órdenes con "maker address not
#   allowed", que es un error que no apunta en absoluto a "has cargado el .env que no era".

# --- lo imprescindible ---
# Clave privada de la wallet que firma. No sale de tu máquina.
PRIVATE_KEY=

# --- credenciales de API, si ya las tienes derivadas ---
# Si están las tres, el bot las usa directamente y se ahorra derivarlas en cada arranque.
# Si las dejas vacías, las deriva solo a partir de PRIVATE_KEY.
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# --- solo con proxy wallet de Polymarket ---
# Si entraste por la web con email o navegador, los fondos están en una proxy wallet
# distinta de la que firma. Con wallet propia (EOA), deja las dos vacías.
#   0 = EOA · 1 = proxy de email/Magic · 2 = proxy de navegador · 3 = 1271
POLY_SIGNATURE_TYPE=
POLY_FUNDER=

# --- cerrojos y límites ---
# Segundo cerrojo: sin esto a "yes", stalebot NO manda ninguna orden ni con --live.
STALEBOT_LIVE=
# Topes del día. El de gasto es a la vez el capital necesario y la pérdida máxima.
# Para la primera sesión: STALEBOT_MAX_SPEND=5 STALEBOT_MAX_ORDERS=2
STALEBOT_MAX_SPEND=
STALEBOT_MAX_ORDERS=
# Solo se opera en ratos tranquilos: tope de detecciones/hora. El 102 es el primer cuartil medido
# (regimen.py D). Subirlo da mas oportunidades y menos margen por operacion; 193 es la mediana-alta,
# por encima de ahi el mecanismo se pone en negativo. Vacio = 102.
STALEBOT_MAX_ACT=

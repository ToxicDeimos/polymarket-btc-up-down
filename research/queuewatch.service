[Unit]
Description=queuewatch - graba el libro de Polymarket por WSS al milisegundo (solo escucha, NO opera)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alex
WorkingDirectory=/home/alex/polymarket-btc-up-down/research
ExecStart=/usr/bin/python3 -u /home/alex/polymarket-btc-up-down/research/queuewatch.py
Restart=always
RestartSec=10
Environment=PYTHONIOENCODING=utf-8
# Tras el OOM del 2026-09-23: que un desbordamiento mate al servicio y no a la Pi.
MemoryMax=400M
Nice=5

[Install]
WantedBy=multi-user.target
